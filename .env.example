# Slack: bot token (xoxb-...) and app-level token (xapp-..., scope connections:write)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# X API v2 app-only bearer token
X_BEARER_TOKEN=

# Optional: only track this channel (channel ID, e.g. C0123ABCD). Blank = every channel the bot is in.
BOOST_CHANNEL_ID=
# Optional tuning
POLL_MINUTES=15
TRACK_DAYS=7
DB_PATH=boost.db
