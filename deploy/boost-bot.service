[Unit]
Description=Boost Bot (Slack leaderboard for the X boost crew)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=boostbot
WorkingDirectory=/opt/boost-bot
EnvironmentFile=/opt/boost-bot/.env
ExecStart=/opt/boost-bot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
